---
import Roadmap from './Roadmap';
import { getSiteData, toNavDirection } from '../../lib/notes';

const { directionId } = Astro.props as { directionId: string };
const site = await getSiteData();
const direction = site.directions.find((d) => d.id === directionId);
---

{
	direction && (
		<Roadmap client:load direction={toNavDirection(direction)} />
	)
}
