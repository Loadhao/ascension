---
import KnowledgeGraph, { type GraphData, type GraphNode } from './KnowledgeGraph';
import { getSiteData } from '../lib/notes';

// 全局知识全景：方向 = 复合容器节点（色块区块），分类 = 容器内子节点，
// 包含关系取代连线，容器边距随内容量增长。方向按知识点数降序输出，
// 图例即「内容量排行」。
const site = await getSiteData();

const directionStats = site.directions
  .map((direction) => ({
    direction,
    count: direction.levels.reduce(
      (sum, level) =>
        sum + level.categories.reduce((t, category) => t + category.notes.length, 0),
      0,
    ),
  }))
  .sort((a, b) => b.count - a.count);

const maxDirCount = Math.max(1, ...directionStats.map((s) => s.count));
const maxCatCount = Math.max(
  1,
  ...directionStats.flatMap(({ direction }) =>
    direction.levels.flatMap((level) =>
      level.categories.map((category) => category.notes.length),
    ),
  ),
);

const nodes: GraphNode[] = [];
const groupCounts: Record<string, number> = {};

for (const { direction, count } of directionStats) {
  nodes.push({
    id: direction.id,
    label: `${direction.title} · ${count}`,
    href: direction.href,
    group: direction.title,
    role: 'direction',
    // sqrt 压缩数量差异，避免头部方向过分放大
    weight: Math.sqrt(count / maxDirCount),
  });
  groupCounts[direction.title] = count;
  for (const level of direction.levels) {
    for (const category of level.categories) {
      nodes.push({
        id: category.id,
        label: category.title,
        href: category.href,
        group: direction.title,
        parent: direction.id,
        // 分类整体压在方向之下，保持两级视觉层次
        weight: 0.15 + 0.5 * Math.sqrt(category.notes.length / maxCatCount),
      });
    }
  }
}

const graph: GraphData = { nodes, edges: [] };
---

<KnowledgeGraph
  client:visible
  data={graph}
  height={880}
  groupCounts={groupCounts}
  legendLayout="bar"
/>
