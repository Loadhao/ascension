---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

{/* 侧边栏处于文档流最前，此内联脚本在正文渲染前执行：提前应用目录收起状态，避免换页闪展 */}
<script is:inline>
  try {
    if (localStorage.getItem('ascension:sidebar-collapsed') === '1')
      document.documentElement.dataset.sidebarTree = 'collapsed';
  } catch (e) {}
</script>

<div class="sl-sidebar-tools">
  <div class="sl-sidebar-search">
    <svg
      aria-hidden="true"
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      placeholder="搜索目录…"
      aria-label="搜索目录"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" class="sl-search-clear" aria-label="清除搜索" hidden>
      <svg
        aria-hidden="true"
        width="10"
        height="10"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <div class="sl-sidebar-actions">
    <p class="sl-search-status" aria-live="polite" hidden></p>
    <button type="button" data-tree-action="expand-all">全部展开</button>
    <button type="button" data-tree-action="collapse-all">全部收起</button>
  </div>
</div>

<SidebarPersister>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
