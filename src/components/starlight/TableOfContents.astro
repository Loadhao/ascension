---
/**
 * Starlight TableOfContents 覆盖：
 * 1. 自测作答页 → 刷题导航器（QuizNav）
 * 2. 分类落地页（<方向>/<等级>/<分类>）→ 「本组笔记」列表（正文无章节，默认目录为空壳）
 * 3. 其余页面保持默认目录。
 */
import DefaultTOC from '@astrojs/starlight/components/TableOfContents.astro';
import QuizNavIsland from '../quiz/QuizNavIsland.astro';
import CategoryNav from '../learn/CategoryNav.astro';
import { getCategory } from '../../lib/notes';

const entry = Astro.locals.starlightRoute?.entry as { id: string } | undefined;
const id = entry?.id ?? '';
const segs = id.split('/');
const isCategory =
  segs.length === 3 && ['basic', 'intermediate', 'advanced'].includes(segs[1] ?? '');
const category = isCategory ? await getCategory(id) : null;
---

{id === 'guide/quiz' ? <QuizNavIsland /> : category ? <CategoryNav category={category} /> : <DefaultTOC />}
